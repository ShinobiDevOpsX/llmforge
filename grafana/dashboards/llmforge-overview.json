          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(llmforge_request_duration_seconds_bucket{route=\"/v1/generate\"}[$__rate_interval])))",
          "legendFormat": "P50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "llmforge-prometheus"
