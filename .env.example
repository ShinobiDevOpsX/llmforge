# LLMForge configuration.
# Copy to .env (or run scripts/setup.sh, which generates secrets for you).
# .env is git-ignored. Never commit real keys or passwords.

# ---------------------------------------------------------------- Secrets
# Comma-separated API keys accepted by the gateway (min 16 chars each).
# Generate one with:  openssl rand -hex 32
LLMFORGE_API_KEYS=
# Grafana admin password (required; compose refuses to start without it).
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------- Images / ports
LLMFORGE_IMAGE_TAG=0.1.0
# Host ports are bound to 127.0.0.1 only.
LLMFORGE_API_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---------------------------------------------------------------- Model
LLMFORGE_DEFAULT_MODEL=llama3.2:1b
# Extra models clients may request (comma-separated); default model is always allowed.
LLMFORGE_ALLOWED_MODELS=
LLMFORGE_OLLAMA_KEEP_ALIVE=10m

# ---------------------------------------------------------------- Gateway behaviour
LLMFORGE_LOG_LEVEL=INFO
LLMFORGE_LOG_FORMAT=json
LLMFORGE_AUTH_ENABLED=true
LLMFORGE_DOCS_ENABLED=true
LLMFORGE_RATE_LIMIT_ENABLED=true
LLMFORGE_RATE_LIMIT_REQUESTS_PER_MINUTE=30
LLMFORGE_RATE_LIMIT_BURST=10
LLMFORGE_MAX_CONCURRENT_GENERATIONS=2
LLMFORGE_QUEUE_TIMEOUT_SECONDS=10
LLMFORGE_GENERATION_TIMEOUT_SECONDS=120
LLMFORGE_MAX_PROMPT_CHARS=8000
LLMFORGE_DEFAULT_MAX_TOKENS=256
LLMFORGE_MAX_OUTPUT_TOKENS=1024

# ---------------------------------------------------------------- Ollama runtime
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MEMORY_LIMIT=6g
